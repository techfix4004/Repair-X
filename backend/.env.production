LOG_LEVEL=info
LOG_FORMAT=json

QUALITY_METRICS_ENABLED=true
DEFECT_RATE_THRESHOLD=3.4
PERFORMANCE_THRESHOLD=1000

ENABLE_SWAGGER=false
ENABLE_METRICS=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

