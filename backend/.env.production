DATADOG_API_KEY=demo_datadog_key

# --- Production Testing & Best Practices additions ---
# Healthcheck endpoint for Docker/Orchestration (if supported by your app)
# HEALTHCHECK_PATH=/api/v1/health
# HEALTHCHECK_INTERVAL=30s

# Prisma log queries in production (optional)
# PRISMA_LOG_QUERIES=true

# CORS allowed origins (if your backend supports comma-separated origins)
ALLOWED_ORIGINS=https://demo-repairx.com,https://www.demo-repairx.com

# Timezone for logs and application (recommended for consistency)
TZ=UTC

# Local storage configuration (if used, uncomment and set as needed)
# LOCAL_STORAGE_PATH=/app/data/uploads
# LOCAL_STORAGE_BASE_URL=https://demo-repairx.com/uploads
# LOCAL_STORAGE_MAX_SIZE=104857600
# LOCAL_STORAGE_ALLOWED_TYPES=image/*,application/pdf,text/*

# Sentry/monitoring (if used)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Backup/retention configuration (if implemented)
# BACKUP_S3_BUCKET=your-backups-bucket
# BACKUP_RETENTION_DAYS=30

# Uncomment to enable debug logs for troubleshooting in staging
# DEBUG=repairx:*
